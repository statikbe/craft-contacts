{# @var plugin \statikbe\contacts\Contacts #}
{# @var settings \statikbe\contacts\models\Settings #}

{% import '_includes/forms.twig' as forms %}

{{ forms.checkboxGroupField({
    label: "User groups"|t('contacts'),
    instructions: "Select which tabs should be visible in the contact detail view."|t('contacts'),
    id: 'userGroups',
    name: 'userGroups',
    options: groups,
    values: settings.userGroups,
    checked: settings.userGroups,
    errors: settings.getErrors('userGroups'),
}) }}

{{ forms.selectField({
    label: "Default user group for new contacts"|t('contacts'),
    instructions: "New contacts will be automatically assigned to this user group."|t('contacts'),
    id: 'defaultUserGroup',
    name: 'defaultUserGroup',
    options: [{ label: 'None'|t('contacts'), value: '' }]|merge(groups),
    value: settings.defaultUserGroup,
    errors: settings.getErrors('defaultUserGroup'),
}) }}

{{ forms.checkboxGroupField({
    label: "Tabs"|t('contacts'),
    instructions: "Select which tabs should be visible in the contact detail view."|t('contacts'),
    id: 'visibleTabs',
    name: 'visibleTabs',
    options: tabs,
    values: settings.visibleTabs,
    checked: settings.visibleTabs,
    errors: settings.getErrors('visibleTabs'),
}) }}

<hr>

{{ forms.autosuggestField({
    label: "Main content template"|t('contacts'),
    id: 'contentTemplate',
    name: 'contentTemplate',
    suggestions: craft.cp.getTemplateSuggestions(),
    suggestEnvVars: true,
    value: settings.contentTemplate,
}) }}


{{ forms.autosuggestField({
    label: "Sidebar template"|t('contacts'),
    id: 'sidebarTemplate',
    name: 'sidebarTemplate',
    suggestions: craft.cp.getTemplateSuggestions(),
    suggestEnvVars: true,
    value: settings.sidebarTemplate,
}) }}

{{ forms.autosuggestField({
    label: "Contact title format"|t('contacts'),
    instructions: "This format is used to display the title of the contact's detail page."|t('contacts'),
    id: 'contactTitleFormat',
    name: 'contactTitleFormat',
    suggestions: craft.cp.getTemplateSuggestions(),
    suggestEnvVars: true,
    value: settings.contactTitleFormat,
}) }}