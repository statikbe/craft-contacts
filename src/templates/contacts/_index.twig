{% extends '_layouts/elementindex' %}
{% set title = 'Contacts'|t('app') %}
{% set elementType = 'statikbe\\contacts\\elements\\Contact' %}
{% set canHaveDrafts = true %}
{% set selectedSubnavItem = 'allContacts' %}

{% set crumbs = [
    { label: "Contacts"|t('contacts'), url: cpUrl('contacts') },
] %}

{% block actionButton %}
    {% set buttonLabel = 'New Contact'|t('contacts') %}
    <a href="{{ cpUrl('contacts/new') }}" class="btn submit add icon">{{ buttonLabel }}</a>
{% endblock %}
