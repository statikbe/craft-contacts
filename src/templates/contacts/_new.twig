{% import '_includes/forms' as forms %}

{% set redirect = craft.app.request.get('redirect') ?? 'contacts' %}

<form method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('contacts/contacts/create') }}
    {{ redirectInput(redirect) }}

    {{ contact.getFieldLayout().createForm(contact).render() | raw }}

    <div class="buttons">
        <button type="submit" class="btn submit">{{ 'Create Contact'|t('contacts') }}</button>
        <a href="{{ url('contacts') }}" class="btn">{{ 'Cancel'|t('app') }}</a>
    </div>
</form>
