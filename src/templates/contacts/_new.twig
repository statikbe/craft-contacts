{% import '_includes/forms' as forms %}

{% set redirect = craft.app.request.get('redirect') ?? 'contacts' %}

<form method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('contacts/contacts/create') }}
    {{ redirectInput(redirect) }}
    <div id="fields">
    {% for tab in form.tabs %}
        {{ tab.getContent() | raw }}
    {% endfor %}
    </div>
    <hr>
    <h2>{{ 'Extra' | t('contacts') }}</h2>

    {{ forms.checkBoxField({
        label: 'Convert contact to user'|t('contacts'),
        instructions: 'Checking this checkbox will create a pending user for this contact and send them an activation email.'|t('contacts'),
        id: 'convertUser',
        name: 'convertUser',
    }) }}

    <div class="buttons">
        <button type="submit" class="btn submit">{{ 'Create Contact'|t('contacts') }}</button>
        <a href="{{ url('contacts') }}" class="btn">{{ 'Cancel'|t('app') }}</a>
    </div>
</form>
