{#
/**
 * Simple Relations Table Template
 *
 * Displays a simple, flexible table for showing relations on a contact/user detail page.
 *
 * @param string title - Table heading/title
 * @param array columns - Array of column definitions: [{label: 'Column Name', key: 'dataKey', link: true|false, type: 'text'}, ...]
 * @param array|QueryInterface rows - Element query or array of data rows
 * @param string|null emptyMessage - Message to show when no rows (default: "No items found.")
 * @param bool paginate - Enable pagination (default: false)
 * @param int pageSize - Items per page when pagination enabled (default: 20)
 *
 * Column Definition Properties:
 * - label (string): Column header label
 * - key (string): Key to access in row data (e.g., 'title', 'dateCreated', 'status')
 * - link (bool): If true, wraps value in link using element.cpEditUrl (default: false)
 *                Links to cellValue.cpEditUrl if available, otherwise row.cpEditUrl
 * - type (string): Format type for the cell value (default: 'text')
 *                  Options: 'text', 'date', 'datetime', 'timestamp', 'relation', 'dropdown'
 *
 * Supported Types:
 * - 'text' (default): Renders value as-is (supports HTML via |raw)
 * - 'date': Formats date using |date('short')
 * - 'datetime': Formats datetime using |datetime('short')
 * - 'timestamp': Formats timestamp using |timestamp
 * - 'relation': Resolves relation field using .status(null).one().title (automatically linked)
 * - 'dropdown': Gets the label from dropdown field value (value.label)
 *
 * Basic Example (without pagination):
 *
 * {% set columns = [
 *   {label: 'Title', key: 'title', link: true},
 *   {label: 'Status', key: 'status'},
 *   {label: 'Created', key: 'dateCreated', type: 'date'}
 * ] %}
 *
 * {% include 'contacts/_relations-table' with {
 *   title: 'Registrations',
 *   columns: columns,
 *   rows: entries.all()
 * } %}
 *
 * Example with Pagination (Element Query):
 *
 * {% include 'contacts/_relations-table' with {
 *   title: 'Registrations',
 *   columns: columns,
 *   rows: craft.entries().relatedTo(element),  {# Pass query, not .all() #}
 *   paginate: true,
 *   pageSize: 20
 * } %}
 *
 * Advanced Example (with custom formatting):
 *
 * {% set formattedRows = [] %}
 * {% for entry in entries %}
 *   {% set formattedRows = formattedRows|merge([{
 *     title: entry.title,
 *     status: '<span class="status ' ~ entry.statusColor ~ '"></span> ' ~ entry.status,
 *     date: entry.dateCreated
 *   }]) %}
 * {% endfor %}
 *
 * {% set columns = [
 *   {label: 'Title', key: 'title', link: true},
 *   {label: 'Status', key: 'status'},
 *   {label: 'Date', key: 'date', type: 'date'}
 * ] %}
 *
 * {% include 'contacts/_relations-table' with {
 *   title: 'Entries',
 *   columns: columns,
 *   rows: formattedRows
 * } %}
 */
#}

{% set title = title ?? 'Relations' %}
{% set columns = columns ?? [] %}
{% set rows = rows ?? [] %}
{% set emptyMessage = emptyMessage ?? 'No items found.'|t('contacts') %}
{% set formater = craft.app.formatter %}
{% set paginate = paginate ?? false %}
{% set pageSize = pageSize ?? 20 %}

{# Determine if rows is an element query or array #}
{% set isQuery = rows is iterable and rows.limit is defined %}

{# Set up pagination variables #}
{% if paginate and not isQuery %}
    {# Array Pagination using ArrayDataProvider #}
    {% set dataProvider = create({
        'class': 'yii\\data\\ArrayDataProvider',
        'allModels': rows,
        'pagination': {
            'pageSize': pageSize,
            'pageParam': 'relationPage'
        }
    }) %}
    {% set displayRows = dataProvider.getModels() %}
    {% set pagination = dataProvider.getPagination() %}
    {% set showPagination = true %}
{% elseif not paginate %}
    {# No pagination #}
    {% set displayRows = rows %}
    {% set showPagination = false %}
{% endif %}

{# For element queries with pagination, open paginate tag #}
{% if paginate and isQuery %}
    {% paginate rows.limit(pageSize) as pageInfo, paginatedRows %}
    {% set displayRows = paginatedRows %}
    {% set showPagination = true %}
{% endif %}

<div class="field">
    <div class="heading">
        <label>
            {{ title|t('app') }}
        </label>
    </div>
    <div class="input">
        {% if displayRows is not empty %}
            <div class="tableview">
                <table class="data fullwidth">
                    <thead>
                    <tr>
                        {% for column in columns %}
                            <th scope="col">{{ column.label|t('app') }}</th>
                        {% endfor %}
                    </tr>
                    </thead>
                    <tbody>
                    {% for row in displayRows %}
                        <tr>
                            {% for column in columns %}
                                {% set cellValue = attribute(row, column.key) %}
                                {% set columnType = column.type ?? 'text' %}
                                {% set useLink = column.link ?? false %}
                                {% set linkUrl = null %}

                                {# Apply type-based formatting #}
                                {% set formattedValue = cellValue %}
                                {% set relatedElement = null %}

                                {% if cellValue %}
                                    {% switch columnType %}
                                    {% case 'date' %}
                                        {% set formattedValue = formater.asDate(cellValue, 'short') %}
                                    {% case 'datetime' %}
                                        {% set formattedValue = formater.asDateTime(cellValue, 'short') %}
                                    {% case 'timestamp' %}
                                        {% set formattedValue = cellValue|timestamp %}
                                    {% case 'relation' %}
                                        {% set relatedElement = cellValue.status(null).one() %}
                                        {% set formattedValue = relatedElement ? relatedElement.title : '-' %}
                                    {% case 'dropdown' %}
                                        {% set formattedValue = cellValue.label ?? cellValue %}
                                    {% default %}
                                        {# 'text' type or any other: render as-is #}
                                        {% set formattedValue = cellValue %}
                                    {% endswitch %}
                                {% endif %}

                                {# Determine link URL if link property is true or type is relation #}
                                {% if useLink or (columnType == 'relation' and relatedElement) %}
                                    {# For relation types, use the related element's URL #}
                                    {% if columnType == 'relation' and relatedElement and relatedElement.cpEditUrl is defined %}
                                        {% set linkUrl = relatedElement.cpEditUrl %}
                                        {# Check if cellValue has cpEditUrl (it's an element) #}
                                    {% elseif cellValue.cpEditUrl is defined %}
                                        {% set linkUrl = cellValue.cpEditUrl %}
                                        {# Otherwise check if row itself has cpEditUrl #}
                                    {% elseif row.cpEditUrl is defined %}
                                        {% set linkUrl = row.cpEditUrl %}
                                    {% endif %}
                                {% endif %}

                                {% if loop.first %}
                                    <th scope="row">
                                        {% if linkUrl %}
                                            <a href="{{ linkUrl }}" target="_blank">{{ formattedValue }}</a>
                                        {% else %}
                                            {{ formattedValue|raw }}
                                        {% endif %}
                                    </th>
                                {% else %}
                                    <td>
                                        {% if linkUrl %}
                                            <a href="{{ linkUrl }}" target="_blank">{{ formattedValue }}</a>
                                        {% else %}
                                            {{ formattedValue|raw }}
                                        {% endif %}
                                    </td>
                                {% endif %}
                            {% endfor %}
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>

            {# Pagination UI #}
            {% if showPagination %}
                <div id="footer" class="flex">
                    <div id="count-container" class="light flex-grow">
                        {% if isQuery %}
                            {# Element Query: Use Craft's built-in pagination #}
                            {% include '_includes/pagination' with {
                                'pageInfo': pageInfo,
                                'itemLabel': 'item'|t('app'),
                                'itemsLabel': 'items'|t('app')
                            } %}
                        {% else %}
                            {# Array: Build custom pagination UI #}
                            {% set currentPage = pagination.getPage() + 1 %}
                            {% set totalPages = pagination.getPageCount() %}
                            {% set totalCount = dataProvider.getTotalCount() %}
                            {% set first = ((currentPage - 1) * pageSize) + 1 %}
                            {% set last = min(currentPage * pageSize, totalCount) %}

                            <div class="flex pagination">
                                <div class="page-info">
                                    {{ "{first, number}-{last, number} of {total, number} {total, plural, =1{item} other{items}}"|t('app', {
                                        first: first,
                                        last: last,
                                        total: totalCount,
                                    }) }}
                                </div>

                                <nav class="flex" aria-label="{{ 'Pagination'|t('app') }}">
                                    {% if currentPage > 1 %}
                                        <a class="page-link prev-page"
                                           href="{{ url(craft.app.request.url, {relationPage: currentPage - 1}) }}"
                                           title="{{ 'Previous Page'|t('app') }}"
                                           aria-label="{{ 'Previous Page'|t('app') }}"></a>
                                    {% else %}
                                        <button class="page-link prev-page disabled"
                                                title="{{ 'Previous Page'|t('app') }}"
                                                aria-label="{{ 'Previous Page'|t('app') }}"
                                                role="button" disabled></button>
                                    {% endif %}

                                    {% if currentPage < totalPages %}
                                        <a class="page-link next-page"
                                           href="{{ url(craft.app.request.url, {relationPage: currentPage + 1}) }}"
                                           title="{{ 'Next Page'|t('app') }}"
                                           aria-label="{{ 'Next Page'|t('app') }}"></a>
                                    {% else %}
                                        <button class="page-link next-page disabled"
                                                title="{{ 'Next Page'|t('app') }}"
                                                aria-label="{{ 'Next Page'|t('app') }}"
                                                role="button" disabled></button>
                                    {% endif %}
                                </nav>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% else %}
            <p class="zilch small">{{ emptyMessage }}</p>
        {% endif %}
    </div>
</div>

{# Close paginate tag if it was opened for element queries #}
{% if paginate and isQuery %}
    {% endpaginate %}
{% endif %}
