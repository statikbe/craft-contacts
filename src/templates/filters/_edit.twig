{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}
{% set title = isNew ? "Create a new filter"|t('contacts') : filter.label %}

{% block content %}
    <form method="post" accept-charset="UTF-8" data-saveshortcut>
        {{ csrfInput() }}
        {{ actionInput('contacts/filter/save') }}
        {{ redirectInput('contacts/filters') }}
        
        {% if not isNew %}
            {{ hiddenInput('filterId', filter.id) }}
        {% endif %}
        
        {{ hiddenInput('ownerId', currentUser.id) }}

        <div class="fields">
            {{ forms.textField({
                label: "Filter Name"|t('contacts'),
                instructions: "Give your filter a descriptive name"|t('contacts'),
                id: 'label',
                name: 'label',
                value: filter.label,
                required: true,
                autofocus: true,
                errors: filter.getErrors('label')
            }) }}

            {{ forms.lightswitchField({
                label: "Shared"|t('contacts'),
                instructions: "Allow other users to see and use this filter"|t('contacts'),
                id: 'shared',
                name: 'shared',
                on: filter.shared ?? true,
                errors: filter.getErrors('shared')
            }) }}

            {% set condition = filter.condition ?? filter.createCondition() %}
            {% do condition.setAttributes({
                mainTag: 'div',
                id: 'condition',
                name: 'condition'
            }, false) %}

            {{ forms.field({
                label: "Filter Conditions"|t('contacts'),
                instructions: "Define the conditions that contacts must meet to be included in this filter."|t('contacts'),
                id: 'condition-field'
            }, condition.getBuilderHtml()) }}

            {# Debug info #}
            {% if filter.conditionConfig and currentUser.admin %}
                <div style="background: #f0f0f0; padding: 10px; margin: 10px 0; font-size: 11px;">
                    <strong>Debug - Stored condition config:</strong><br>
                    {{ filter.conditionConfig }}
                </div>
            {% endif %}
        </div>

        <div class="buttons">
            <div class="btngroup">
                <input type="submit" class="btn submit" value="{{ isNew ? 'Create Filter'|t('contacts') : 'Save Filter'|t('contacts') }}">
            </div>
        </div>
    </form>
{% endblock %}

{% css %}
.condition-container {
    border: 1px solid #e3e5e8;
    border-radius: 3px;
    padding: 14px;
    background-color: #fafafa;
}

.field-info {
    background-color: #f7f7f7;
    padding: 14px;
    border-radius: 3px;
    border: 1px solid #e3e5e8;
}

.field-info .info-item {
    margin-bottom: 7px;
}

.field-info .info-item:last-child {
    margin-bottom: 0;
}

.field-info .status {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: bold;
    text-transform: uppercase;
}

.field-info .status.enabled {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
}
{% endcss %}