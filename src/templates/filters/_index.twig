{% set title = title ?? "Contact Filters"|t('contacts') %}
{% set selectedSubnavItem = 'filters' %}

{# Register the AdminTable asset bundle #}
{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') %}

{% block content %}
    {# Mount point for VueAdminTable #}
    <div id="filters-admin-table"></div>
{% endblock %}

{% js %}
new Craft.VueAdminTable({
    container: '#filters-admin-table',
    tableDataEndpoint: '{{ cpUrl('contacts/filters/data') }}',
    search: true,
    searchPlaceholder: '{{ "Search filters…"|t('contacts') }}',
    checkboxes: true,
    allowMultipleSelections: true,
    allowMultipleDeletions: true,
    deleteAction: 'contacts/filter/delete',
    deleteConfirmationMessage: '{{ "Are you sure you want to delete \"{name}\"?"|t('contacts') }}',
    deleteSuccessMessage: '{{ "\"{name}\" deleted."|t('contacts') }}',
    deleteFailMessage: '{{ "Couldn't delete \"{name}\"."|t('contacts') }}',
    emptyMessage: '{{ "No filters exist yet."|t('contacts') }}',
    noSearchResults: '{{ "No filters found."|t('contacts') }}',
    perPage: 20,
    fullPane: true,
    itemLabels: {
        singular: '{{ "Filter"|t('contacts') }}',
        plural: '{{ "Filters"|t('contacts') }}'
    },
    columns: [
        {
            name: '__slot:title',
            title: '{{ "Name"|t('app') }}',
            sortField: 'label'
        },
        {
            name: 'shared',
            title: '{{ "Shared"|t('contacts') }}',
            callback: function(value) {
                if (value) {
                    return '<span class="status enabled" title="{{ "Shared"|t('contacts') }}"></span>';
                } else {
                    return '<span class="status disabled" title="{{ "Private"|t('contacts') }}"></span>';
                }
            }
        },
        {
            name: 'owner',
            title: '{{ "Owner"|t('contacts') }}'
        }
    ],
    buttons: [
        {
            label: '{{ "New filter"|t('contacts') }}',
            icon: 'plus',
            href: '{{ cpUrl('contacts/filters/edit') }}',
            enabled: true
        }
    ],
    checkboxStatus: function(row) {
        return row.canDelete;
    }
});
{% endjs %}